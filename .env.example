# ============================================================================
# 嘉环声枢录音卡设备管理服务 —— 环境变量样例
# 复制为 .env 后按实际环境修改。生产环境务必替换 AUTH_KEY_SECRET 与
# CASDOOR_CLIENT_SECRET，并设置 APP_ENV=production。
# ============================================================================

# ---------- 应用 ----------
APP_NAME=嘉环声枢录音卡设备管理服务
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
API_PREFIX=/voicehub/api

# ---------- 数据库 ----------
# 本地开发：SQLite（零依赖，可直接跑通全部业务闭环与测试）
DATABASE_URL=sqlite:///./data/dev.db
# 生产环境：MySQL 8.0.16+
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/voicehub_device?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- Casdoor 认证 ----------
# 注意：Casdoor 实例配置了 authPrefix=auth，因此所有接口都在 /auth 之下，
# 例如 /auth/api/login/oauth/introspect、/auth/api/userinfo。
CASDOOR_BASE_URL=https://office.uassist.cn:40000/auth
# 留空则取 CASDOOR_BASE_URL；仅在 JWT 校验且需与签发方完全一致时填写
CASDOOR_ISSUER=
# 应用 clientId / clientSecret（在 Casdoor 后台「应用」中查看）
CASDOOR_CLIENT_ID=voicehub
CASDOOR_CLIENT_SECRET=6932b8ce0b655b9421b5
# 默认组织（多租户场景下以 Token 中的 owner 字段为准，此值仅作兜底）
CASDOOR_ORGANIZATION=voicehub.bestlink.com.cn
# 校验方式：auto | introspect | userinfo | jwt
#   auto      = 有 client 凭据则 introspect，失败降级 userinfo；无凭据则 userinfo
#   introspect= 服务端校验 Token 有效性（最严谨，推荐）
#   userinfo  = 调用 userinfo 端点换取用户信息
#   jwt       = 使用 Casdoor JWKS 本地验签（性能最好，需网络获取公钥）
CASDOOR_VERIFY_METHOD=auto
CASDOOR_TIMEOUT=10
# 实例证书是否有效；自签证书场景可设为 false
CASDOOR_VERIFY_TLS=true
CASDOOR_JWKS_CACHE_TTL=3600

# 管理员判定：Casdoor 用户 role 命中列表，或用户所属 group 命中列表
CASDOOR_ADMIN_ROLES=global_admin,admin
CASDOOR_ADMIN_GROUPS=admins
# 跨组织管理员（可访问全部租户），默认仅 Casdoor 内置 global_admin
CASDOOR_GLOBAL_ADMIN_ROLES=global_admin

# ---------- 设备凭证（AuthKey） ----------
# 用于 HMAC-SHA256 摘要的��务端密钥，生产环境必须替换为随机高强度值
AUTH_KEY_SECRET=please-change-this-to-a-long-random-secret
# AuthKey 凭据默认有效期（天），0 表示永不过期
AUTH_KEY_DEFAULT_TTL_DAYS=0
# 设备在线判定超时（秒），最近通信时间超过该值判定为离线
DEVICE_ONLINE_TIMEOUT_SECONDS=300

# ---------- CORS ----------
# 多个用英文逗号分隔，* 表示允许全部
CORS_ORIGINS=*
