# ============================================================================
# 嘉环声枢录音卡设备管理服务 —— 环境变量样例
# 复制为 .env 后按实际环境修改。生产环境务必替换 CASDOOR_CLIENT_SECRET，
# 并设置 APP_ENV=production。
# ============================================================================

# ---------- 应用 ----------
APP_NAME=嘉环声枢录音卡设备管理服务
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
# 所有接口的统一前缀。nginx 反向代理时与后端监听端口一致：
#   浏览器 → https://office.uassist.cn:40000/voicehub-api/...
#   nginx  → http://127.0.0.1:8040/voicehub-api/...（原样透传）
API_PREFIX=/voicehub-api

# ---------- 数据库 ----------
# 本地开发：SQLite（零依赖，可直接跑通全部业务闭环与测试）
DATABASE_URL=sqlite:///./data/dev.db
# 生产环境：MySQL 8.0.16+
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/voicehub_device?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- Casdoor 认证 ----------
# 注意：Casdoor 实例配置了 authPrefix=auth，因此所有接口都在 /auth 之下，
# 例如 /auth/api/login/oauth/introspect、/auth/api/userinfo。
CASDOOR_BASE_URL=https://office.uassist.cn:40000/auth
# 留空则取 CASDOOR_BASE_URL；仅在 JWT 校验且需与签发方完全一致时填写
CASDOOR_ISSUER=
# 应用 clientId / clientSecret（在 Casdoor 后台「应用」中查看）
# clientId 是公开标识符，代码里已内置默认值，这里保持一致即可；
# Casdoor 应用改名后请在后台复核 clientId 是否仍是该值
CASDOOR_CLIENT_ID=6932b8ce0b655b9421b5
# clientSecret 是真正的机密，请从 Casdoor 后台复制填写，不要提交到代码库
CASDOOR_CLIENT_SECRET=
# Casdoor 后台标识（2026-11-08 已改名）：组织 owner=bestlink，应用 name=voicehub
# 组织名同时是员工 owner，即本服务 tenant_id；Token 中有 owner 时以其为准，此值仅作兜底
CASDOOR_ORGANIZATION=bestlink
# 应用名，随 /auth/config 下发给前端与 APP；OAuth 授权以 client_id 为准
CASDOOR_APPLICATION=voicehub
# 校验方式：auto | introspect | userinfo | jwt
#   auto      = 有 client 凭据则 introspect，失败降级 userinfo；无凭据则 userinfo
#   introspect= 服务端校验 Token 有效性（最严谨，推荐）
#   userinfo  = 调用 userinfo 端点换取用户信息
#   jwt       = 使用 Casdoor JWKS 本地验签（性能最好，需网络获取公钥）
CASDOOR_VERIFY_METHOD=auto
# 分配设备时校验工号是否在 Casdoor 中真实存在（防止把设备分给不存在的工号）
#   off      = 不校验（完全离线，仅供测试）
#   optional = 能查就查：查无此人/组织不符/账号禁用则 422 拒绝；
#              Casdoor 不可达或接口无权限时降级放行并记 WARN（默认）
#   required = 连查询都做不到时也 502 拒绝，要求强一致
# 本实例 /auth/api/get-user 是公开只读接口，无需 clientSecret 即可校验；
# 若 Casdoor 收紧权限，配好 clientSecret 走服务令牌，或由后端透传管理员 Token。
CASDOOR_VERIFY_EMPLOYEE=optional
CASDOOR_TIMEOUT=10
# 实例证书是否有效；自签证书场景可设为 false
CASDOOR_VERIFY_TLS=true
CASDOOR_JWKS_CACHE_TTL=3600

# 管理员判定：Casdoor 用户 role 命中列表，或用户所属 group 命中列表
# 注意：Casdoor 的 roles 是对象数组，角色名取 Role.name；permissions 同理取 Permission.name
#   - role_admin 是 Casdoor 内置管理员角色的常见 name，别只写 admin
#   - groups 在 API 里是全限定名（如 bestlink/admins），这里写短名 admins 即可，
#     服务端匹配时会自动剥离 `组织名/` 前缀；也可写全限定名精确匹配
CASDOOR_ADMIN_ROLES=global_admin,admin,role_admin
CASDOOR_ADMIN_GROUPS=admins
# Casdoor Permission 白名单（推荐做法）：在 Casdoor 后台为应用创建权限，
# 把权限的 name 填到这里，命中该权限的用户即为管理员
# 例：CASDOOR_ADMIN_PERMISSIONS=device-admin
CASDOOR_ADMIN_PERMISSIONS=
# 用户名 / 邮箱白名单（兜底方案，不依赖 Casdoor 权限配置）
# 例：CASDOOR_ADMIN_USERS=admin,zhangsan@acme.com
CASDOOR_ADMIN_USERS=
# 跨组织管理员（可访问全部租户），默认仅 Casdoor 内置 global_admin
CASDOOR_GLOBAL_ADMIN_ROLES=global_admin

# ---------- 设备凭证（AuthKey） ----------
# AuthKey 凭据默认有效期（天），0 表示永不过期
AUTH_KEY_DEFAULT_TTL_DAYS=0
# 设备在线判定超时（秒），最近通信时间超过该值判定为离线。
# APP 上报状态后，所有读取路径（详情 / 我的设备 / 状态列表 / 概览）按此值派生 online
DEVICE_ONLINE_TIMEOUT_SECONDS=300
# APP 状态上报：下发给客户端的建议心跳间隔（秒），服务端不限流
DEVICE_STATUS_HEARTBEAT_SECONDS=60
# 允许的手机时钟偏差（秒）：采集时刻晚于服务端时间过多、或早于上次接收时间过多的
# 旧快照都会被拒绝，避免离线回放覆盖最新状态
DEVICE_STATUS_MAX_CLOCK_SKEW_SECONDS=300

# ---------- CORS ----------
# 多个用英文逗号分隔，* 表示允许全部。
# nginx 同源代理（/voicehub/ 与 /voicehub-api/ 同源）时用不到 CORS，
# 只有当管理页面与 API 不同源时才需要收敛为具体来源。
CORS_ORIGINS=https://office.uassist.cn:40000
